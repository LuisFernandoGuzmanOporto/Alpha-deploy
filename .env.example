# Copia este archivo a .env y completa lo que necesites. No subas .env al repositorio.
# El proyecto base no requiere claves; esto es por si alguna fuente de datos las pide.

# NASA Earthdata (si descargas productos que requieren login)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Clave de API de OpenTopography u otro proveedor de elevación, si lo usas
OPENTOPOGRAPHY_API_KEY=

# Fotos de Google Places en el mapa (opcional). Sin esto, la web usa las fotos de Wikimedia Commons.
# GOOGLE_PLACES_API_KEY solo se lee en el servidor (función web/api/place-photos.ts): nunca lleva el prefijo VITE_.
# En Google Cloud: restringe la clave a "Places API (New)" y pon una cuota diaria.
GOOGLE_PLACES_API_KEY=
# Activa la consulta desde la web (se lee al compilar). Ponlo en 1 solo si la clave de arriba está configurada.
VITE_PLACES_API=
